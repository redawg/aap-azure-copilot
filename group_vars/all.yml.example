---
# Copy to group_vars/all.yml (or use ansible-vault) — do not commit secrets.

# Workshop AAP + MCP endpoints (required for Red Hat / Controller playbooks)
aap_base_url: https://aap-aap.apps.cluster-wg2cd-2.dynamic2.redhatworkshops.io
aap_mcp_base_url: https://aap-mcp-aap.apps.cluster-wg2cd-2.dynamic2.redhatworkshops.io
aap_mcp_server_path: /mcp

aap_user: admin
aap_password: ""
# Optional: skip token creation if already set
# aap_gateway_token: ""

# Azure AI Foundry
foundry_account: foundry-wg2cd-1
foundry_project: foundry-wg2cd-1-project
foundry_rg: openenv-wg2cd-1
foundry_sub: 9dc2c3d2-35a8-4370-8997-b56a57b5778d
foundry_project_endpoint: ""  # or full https://….services.ai.azure.com/api/projects/…

foundry_model_deployment_name: gpt-4.1
foundry_mcp_connection_name: aap-mcp-bearer
foundry_agent_name: aap-automation-agent
foundry_mcp_server_label: ansible-aap
foundry_mcp_require_approval: always

foundry_verify_mcp_before_register: true
foundry_verify_mcp_tools_list: true
foundry_register_agent: true
foundry_register_connection_arm: true
foundry_validate_certs: false

# Cleanup / redeploy (playbooks/cleanup-foundry.yml, redeploy.yml)
foundry_delete_extra_projects: false
foundry_extra_projects_to_delete:
  - wg2cd-mcp
  - wg2cd-project

# OpenShift (playbooks/verify.yml, openshift-mcp-routes.yml, provision-aap-analytics.yml)
ocp_namespace: aap
# ocp_token: sha256~…
ocp_api_url: https://api.cluster-wg2cd-2.dynamic2.redhatworkshops.io:6443

# AWS open environment (gitignored in all.yml — do not commit)
# aws_access_key_id: ""
# aws_secret_access_key: ""

# Bastion (optional notes in all.yml)
# workshop_bastion_ssh: ssh lab-user@host -p PORT
# workshop_bastion_password: ""

# AAP 2.6 analytics (MetricsService + metrics-utility)
# aap_analytics_enable_metrics_service: true
# aap_analytics_enable_metrics_utility: true

# Ask AAP: MCP first, ansible-navigator fallback (scripts/aap-ask.sh)
# aap_mcp_operation: sync-github-projects

# Sync GitHub repos → Controller projects (./scripts/aap-ask.sh sync-github-projects)
# aap_github_owner: redawg
# aap_organization_id: 1

# Red Hat console (docs/REDHAT-CONSOLE-CREDENTIALS.md) — do not commit secrets
# aap_galaxy_credential_name: Red Hat Automation Hub
# aap_galaxy_hub_url: https://console.redhat.com/api/automation-hub/
# aap_galaxy_auth_url: https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token
# aap_galaxy_api_token: ""
# redhat_analytics_client_id: ""
# redhat_analytics_client_secret: ""

# Optional: set instead of `az account get-access-token`
# foundry_agent_token: ""
# foundry_mgmt_token: ""

# Launch playbook (playbooks/launch-job-template.yml)
# aap_launch_job_template_id: "13"

# Azure Fedora VM + Monitor → Foundry copilot (playbooks/azure-fedora-alerts.yml)
azure_location: eastus
azure_fedora_name_prefix: aap-fedora-demo
azure_fedora_vm_image: "FedoraLinux:fedora-41:41-gen2:latest"
# azure_fedora_test_foundry_invoke: true

# AAP job template (playbooks/aap-create-azure-fedora-template.yml)
# aap_azure_fedora_inventory_id: 3
# aap_azure_fedora_project_name: aap-azure-copilot
